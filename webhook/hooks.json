[
  {
    "id": "redeploy-docker",
    "execute-command": "/scripts/redeploy-docker.sh",
    "command-working-directory": "/",
    "response-message": "Docker redeployment triggered.",
    "trigger-rule": {
      "match": {
        "type": "payload-hmac-sha256",
        "secret": "{{ getenv \"WEBHOOK_SECRET\" }}",
        "parameter": { "source": "header", "name": "X-Hub-Signature-256" }
      }
    }
  },
  {
    "id": "redeploy-apache",
    "execute-command": "/scripts/redeploy-apache.sh",
    "command-working-directory": "/",
    "response-message": "Apache redeployment triggered.",
    "trigger-rule": {
      "match": {
        "type": "payload-hmac-sha256",
        "secret": "{{ getenv \"WEBHOOK_SECRET\" }}",
        "parameter": { "source": "header", "name": "X-Hub-Signature-256" }
      }
    }
  }
]
